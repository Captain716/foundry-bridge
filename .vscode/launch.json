            "name": "Claude Agent — Task",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/claude_agent.py",
            "args": ["--task", "List my 5 most recent memories and summarise them"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/.env"
        }
