# Copy this file to .env and fill in your values.
# VS Code Server and Claude Code will pick this up automatically via launch.json envFile.
# NEVER commit .env to git — it is already in .gitignore.

# === Foundry Credentials ===
FOUNDRY_TOKEN=your-bearer-token-here
FOUNDRY_HOST=https://your-instance.palantirfoundry.com

# === Foundry Ontology (for foundry_bridge.py / foundry_mcp_server.py / claude_agent.py) ===
FOUNDRY_ONTOLOGY_API=your-ontology-api-name
FOUNDRY_MEMORY_TYPE=YourMemoryObjectType
FOUNDRY_CREATE_ACTION=your-create-action-name
FOUNDRY_DELETE_ACTION=your-delete-action-name

# === AIP Agent (for foundry_agent.py) ===
FOUNDRY_AGENT_RID=ri.aip-agents..agent.your-agent-rid-here

# === Anthropic (for claude_agent.py) ===
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-4-0
